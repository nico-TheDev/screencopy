#!/usr/bin/env bash
# Formats and lints staged Swift files. Enable once per clone:
#   git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

staged=()
while IFS= read -r file; do
    staged+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACM -- '*.swift')

[ ${#staged[@]} -eq 0 ] && exit 0

for file in "${staged[@]}"; do
    # Formatting a file with unstaged edits would stage hunks you did not choose.
    if git diff --quiet -- "$file"; then
        xcrun swift-format format --in-place "$file"
        git add -- "$file"
    fi
done

xcrun swift-format lint --strict "${staged[@]}"
